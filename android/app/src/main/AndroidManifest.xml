<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link used by the browser-fallback Google Sign-In flow.
                 The /auth/native helper page redirects to canact://auth-callback#idToken=...
                 once Google sign-in completes in the system browser. The app's
                 App.appUrlOpen listener picks up the URL, extracts the id token,
                 and exchanges it for a Firebase credential. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="canact" android:host="auth-callback" />
            </intent-filter>
            <!-- Deep link fired by the FCM full-screen call notification when the
                 user taps "Answer" or the notification body. Routes to the live
                 ringer/call screen inside the WebView. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="canact" android:host="call" />
            </intent-filter>
            <!-- Generic deep link used by every non-call notification
                 (chat, help, ratings, system). Format:
                 canact://open?to=/inbox/<uid>  -> WebView pushes that route. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="canact" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Native full-screen incoming-call ringer. Launched by
             CanactCallMessagingService when an FCM data message of
             type=call arrives. Behaves like the system phone-app: shows
             over the lockscreen, turns the screen on, presents Answer /
             Decline. The actual WebRTC call is then handed off to
             MainActivity via a canact://call/<id> deep link. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Default notification channel + small icon used by FCM notifications. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="canact_general_v1" />

        <!-- Custom FCM service that converts a `type=call` data message into a
             full-screen, high-priority call notification that wakes the device
             and opens MainActivity to the ringer screen. -->
        <service
            android:name=".CanactCallMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Foreground service that owns the ringer for the duration of an
             incoming call. Promoted with foregroundServiceType=phoneCall so
             we get the BAL exemption needed to launch IncomingCallActivity
             on an unlocked device — without this the full-screen ringer
             only ever auto-launches when the device is locked, which is
             exactly the bug WhatsApp / Signal solve the same way. -->
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Incoming voice/video call ringer" />
        </service>

        <!-- Receives Answer / Decline taps from the call notification and
             from IncomingCallActivity. Decline writes status:'rejected'
             straight to RTDB; Answer cancels the notification then forwards
             into MainActivity via canact://call/<id>?action=answer. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.canact.app.CALL_ANSWER" />
                <action android:name="com.canact.app.CALL_DECLINE" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notifications (Android 13+ requires runtime grant) and full-screen
         heads-up call notifications (USE_FULL_SCREEN_INTENT, install-time on
         older devices, runtime managed-by-Settings on Android 14+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Location for help-radius matching. We declare both fine + coarse;
         runtime request flow asks for fine first and falls back to coarse. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Voice calling: capture mic + manage Bluetooth audio routing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Video calling: front + back cameras. The WebView's WebChromeClient
         needs the manifest declaration before it can grant the WebRTC
         RESOURCE_VIDEO_CAPTURE prompt; without it getUserMedia({video:true})
         silently fails inside the bundled webview. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Background reliability: ask for battery optimization exemption so the
         app can keep its socket / FCM stream alive while idle. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Foreground service used while a voice call is active so the OS does
         not kill the WebRTC connection if the user backgrounds the app.
         FOREGROUND_SERVICE_TYPE_PHONE_CALL on Android 14+ additionally
         requires MANAGE_OWN_CALLS — without it startForeground() throws
         SecurityException and the call screen never appears on the
         lockscreen. SPECIAL_USE is declared as a fall-back for OEMs that
         silently reject the phoneCall type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- DISABLE_KEYGUARD lets the IncomingCallActivity dismiss the
         lockscreen so the user can hit Answer / Decline without unlocking. -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <!-- TURN_SCREEN_ON (declared on Android 8.1+ via window flags only
         needs WAKE_LOCK in the manifest — already declared above). -->
</manifest>

